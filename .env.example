# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: modelo de Gemini a usar (opcional; por defecto gemini-3.6-flash).
GEMINI_MODEL="gemini-3.6-flash"

# GEMINI_FALLBACK_MODELS: cadena de respaldo ante saturación (503). Opcional.
GEMINI_FALLBACK_MODELS="gemini-3.7-flash,gemini-flash-latest"

# ASESOR IA (solo texto) — proveedor configurable.
# "gemini" (por defecto) o "openai" para usar cualquier API compatible con
# OpenAI Chat Completions GRATIS: Groq, DeepSeek, OpenRouter, Cerebras, Together...
AI_PROVIDER="gemini"

# Ejemplo con GROQ (gratis, sin tarjeta): crea tu clave en https://console.groq.com
#   AI_PROVIDER="openai"
#   OPENAI_BASE_URL="https://api.groq.com/openai/v1"
#   OPENAI_API_KEY="gsk_..."
#   OPENAI_MODEL="llama-3.3-70b-versatile"
#
# Ejemplo con DEEPSEEK (muy barato): https://platform.deepseek.com
#   AI_PROVIDER="openai"
#   OPENAI_BASE_URL="https://api.deepseek.com"
#   OPENAI_API_KEY="sk-..."
#   OPENAI_MODEL="deepseek-chat"
#
# Nota: la EXTRACCIÓN de cotizaciones/O.C. (OCR de fotos/PDF) sigue usando
# Gemini (necesita visión). El Asesor IA usa el proveedor de arriba.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL / SUPABASE_ANON_KEY: base de datos en la nube (persistencia multi-dispositivo).
# La anon key es pública por diseño; el acceso se controla con RLS + Supabase Auth.
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_ANON_KEY="anon_public_key"

# SUPABASE_SERVICE_ROLE_KEY (SOLO SERVIDOR, NUNCA exponer al cliente):
# permite al panel de administración crear usuarios (Supabase Auth admin API).
SUPABASE_SERVICE_ROLE_KEY="service_role_key"
